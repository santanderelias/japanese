# --- App Identity ---
APP_NAME=日本語 勉強
APP_SHORT_NAME=日本語
APP_DESCRIPTION=エリアスのペギ
APP_VERSION=1.0.4
APP_URL=https://santael.com

# --- Localization & Metadata ---
LANG=en
DIR=ltr
CATEGORIES=日本語, 日本人, 勉強

# --- Navigation & Scope ---
START_URL=/
SCOPE=/

# --- Display & Appearance ---
# Options for DISPLAY_MODE: standalone, fullscreen, minimal-ui, browser
DISPLAY_MODE=standalone
# Options for ORIENTATION: any, portrait, landscape, portrait-primary, landscape-primary
ORIENTATION=any
BACKGROUND_COLOR=#ffffff
THEME_COLOR=#1a1a1a

# --- Icons & PWA Extras ---
ICON_192_PATH=/src/icon-192.png
ICON_512_PATH=/src/icon-512.png
ICON_PURPOSE=any maskable

# --- Service Worker Options ---
# Options for CACHE_STRATEGY: cache-first, network-first, stale-while-revalidate
CACHE_STRATEGY=stale-while-revalidate
# Optional offline fallback page (leave blank if not used)
OFFLINE_PAGE=/offline.html
# PWA Cache Blacklist (comma-separated folders, files, or wildcards)
CACHE_EXCLUDE = old, scripts, *.md, *.py, CNAME, working.html
